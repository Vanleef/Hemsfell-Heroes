{
  "name": "hemsfell-heroes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "rules:migrate": "node scripts/normalize-rules-migration-inputs.mjs && node scripts/fix-artifact-activation-runtime.mjs && node scripts/repair-card-semantics-migration.mjs && node scripts/prepare-card-semantics-v2.mjs && node scripts/apply-card-semantics-v2.mjs && node scripts/apply-card-semantics-v2-followup.mjs && node scripts/apply-gameplay-polish-v3.mjs && node scripts/apply-ui-rules-polish-v4.mjs && node scripts/apply-ui-interaction-polish-v5.mjs",
    "predev": "npm run rules:migrate",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "npm run rules:migrate",
    "build": "bash scripts/build-verified.sh",
    "vercel-build": "npm run rules:migrate && node scripts/normalize-ci-tests.mjs && node --test tests/*.test.mjs && next build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "dev:vinext": "vite",
    "check:vinext": "vinext check",
    "test:rules": "npm run rules:migrate && node --test tests/*.test.mjs",
    "audit:cards": "node scripts/audit-card-rules.mjs",
    "audit:cards:full": "npm run rules:migrate && node scripts/export-card-implementation-audit.mjs",
    "simulate:headless": "node scripts/simulate-games.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.7.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Hemsfell Heroes"
}
