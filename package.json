{
  "name": "hemsfell-heroes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "prepare:project": "node scripts/project-maintenance.mjs",
    "rules:migrate": "npm run prepare:project",
    "predev": "npm run prepare:project",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "npm run prepare:project && npm run cards:art:generate",
    "build": "bash scripts/build-verified.sh",
    "typecheck:ai": "tsc -p tsconfig.ai.json --noEmit",
    "typecheck:online": "tsc -p tsconfig.online.json --noEmit",
    "test:node": "bash scripts/test-node.sh",
    "build:next": "next build",
    "vercel-build": "npm run test:rules && npm run ai:calibrate:benchmark && npm run cards:art:generate && npm run build:next",
    "start": "vinext start",
    "test": "npm run test:rules",
    "test:presentation": "node --test tests/priority-hero-interaction.test.mjs tests/requested-ui-rendering.test.mjs tests/card-art-lifecycle.test.mjs tests/match-loading-lifecycle.test.mjs tests/card-interaction-performance-contract.test.mjs tests/match-loading-card-preload.test.mjs",
    "test:build": "npm run test:rules && npm run cards:art:generate && npm run build:next",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "dev:vinext": "vite",
    "check:vinext": "vinext check",
    "test:rules": "npm run prepare:project && npm run typecheck:ai && npm run typecheck:online && npm run test:node",
    "audit:cards": "node scripts/audit-card-rules.mjs",
    "audit:cards:full": "npm run prepare:project && node scripts/export-card-implementation-audit.mjs",
    "cards:manual:list": "node scripts/card-tools.mjs manual-list",
    "cards:manual:analyze": "node scripts/card-tools.mjs manual-analyze",
    "cards:extract": "node scripts/card-tools.mjs extract",
    "cards:art:generate": "node scripts/generate-card-art.mjs",
    "simulate:headless": "node scripts/simulate-games.mjs",
    "ai:runtime:build": "node -e \"require('node:fs').rmSync('.ai-runtime',{recursive:true,force:true})\" && tsc -p tsconfig.ai.runtime.json && node -e \"require('node:fs').writeFileSync('.ai-runtime/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "ai:calibrate": "npm run ai:runtime:build && node .ai-runtime/scripts/ai-calibration.js",
    "ai:calibrate:smoke": "npm run ai:runtime:build && node .ai-runtime/scripts/ai-calibration.js --difficulty=Easy,Normal,Hard --seed=20260818 --scenarios=lethal-1,trade-1,overextension-1,hold-response-1,development-1,low-life-1,resources-1,hand-cap-1 --require=Easy:overextension:1,Normal:low-life:1,Hard:*:1 --out=/tmp/hemsfell-ai-smoke",
    "ai:calibrate:benchmark": "npm run ai:runtime:build && node .ai-runtime/scripts/ai-calibration.js --difficulty=Easy,Normal,Hard --seed=20260818 --require=Easy:overextension:0.8,Normal:low-life:0.8 --out=/tmp/hemsfell-ai-benchmark",
    "ai:selfplay": "npm run ai:runtime:build && node .ai-runtime/scripts/ai-selfplay.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@vercel/blob": "2.7.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "displayName": "Hemsfell Heroes"
}
